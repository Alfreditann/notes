<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Register</title>
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Space+Grotesk:wght@400;500;700&display=swap" rel="stylesheet">
  <style>
    :root {
      --bg: #f4efe7;
      --panel: rgba(255, 255, 255, 0.82);
      --panel-border: rgba(26, 29, 36, 0.08);
      --text: #171717;
      --muted: #5f6570;
      --accent: #1f5eff;
      --accent-strong: #1137b8;
      --success: #137547;
    }

    body {
      min-height: 100vh;
      background:
        radial-gradient(circle at top left, rgba(31, 94, 255, 0.14), transparent 30%),
        radial-gradient(circle at bottom right, rgba(19, 117, 71, 0.12), transparent 28%),
        linear-gradient(180deg, #faf7f1 0%, var(--bg) 100%);
      color: var(--text);
      font-family: "Space Grotesk", sans-serif;
    }

    .auth-panel {
      background: var(--panel);
      border: 1px solid var(--panel-border);
      box-shadow: 0 20px 50px rgba(28, 31, 38, 0.08);
      backdrop-filter: blur(12px);
      border-radius: 28px;
    }

    .eyebrow {
      font-size: 0.8rem;
      letter-spacing: 0.18em;
      text-transform: uppercase;
      color: var(--muted);
    }

    .section-title {
      letter-spacing: -0.03em;
    }

    .form-control,
    .form-control:focus {
      border-radius: 16px;
      box-shadow: none;
    }

    .form-control {
      border-color: rgba(26, 29, 36, 0.12);
      background: rgba(255, 255, 255, 0.9);
    }

    .btn {
      border-radius: 16px;
      font-weight: 600;
    }

    .btn-success {
      background: var(--success);
      border-color: var(--success);
    }

    .btn-success:hover {
      background: #0f6039;
      border-color: #0f6039;
    }

    .muted-copy {
      color: var(--muted);
    }
  </style>
</head>
<body>
  <div class="container py-4 py-lg-5">
    <div class="row justify-content-center align-items-center min-vh-100">
      <div class="col-12 col-md-9 col-lg-5">
        <div class="auth-panel p-4 p-lg-5">
          <div class="eyebrow mb-2">Create account</div>
          <h1 class="display-6 section-title mb-2">Register</h1>
          <p class="muted-copy mb-4">Set up an account to start tracking notes and todos.</p>

          <% if (typeof error !== 'undefined' && error) { %>
            <div class="alert alert-danger" role="alert"><%= error %></div>
          <% } %>

          <form method="POST" action="/register" class="d-grid gap-3">
            <input class="form-control form-control-lg" type="text" name="username" placeholder="Username" required minlength="3" maxlength="30" autocomplete="username">
            <input class="form-control form-control-lg" type="password" name="password" placeholder="Password" required minlength="6" maxlength="128" autocomplete="new-password">
            <button class="btn btn-success btn-lg" type="submit">Register</button>
          </form>

          <p class="mt-4 mb-0 muted-copy">Already have an account? <a href="/login">Login</a></p>
        </div>
      </div>
    </div>
  </div>
</body>
</html>