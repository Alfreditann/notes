<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Notes & Todos</title>
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Space+Grotesk:wght@400;500;700&display=swap" rel="stylesheet">
  <style>
    :root {
      --bg: #f4efe7;
      --panel: rgba(255, 255, 255, 0.82);
      --panel-border: rgba(26, 29, 36, 0.08);
      --text: #171717;
      --muted: #5f6570;
      --accent: #1f5eff;
      --accent-strong: #1137b8;
      --danger: #b42318;
    }

    body {
      min-height: 100vh;
      background:
        radial-gradient(circle at top left, rgba(31, 94, 255, 0.14), transparent 30%),
        radial-gradient(circle at top right, rgba(180, 35, 24, 0.1), transparent 24%),
        linear-gradient(180deg, #faf7f1 0%, var(--bg) 100%);
      color: var(--text);
      font-family: "Space Grotesk", sans-serif;
    }

    .page-shell {
      max-width: 1120px;
    }

    .hero-panel,
    .content-panel {
      background: var(--panel);
      border: 1px solid var(--panel-border);
      box-shadow: 0 20px 50px rgba(28, 31, 38, 0.08);
      backdrop-filter: blur(12px);
    }

    .hero-panel { border-radius: 28px; }
    .content-panel { border-radius: 24px; }

    .section-title { letter-spacing: -0.03em; }

    .eyebrow {
      font-size: 0.8rem;
      letter-spacing: 0.18em;
      text-transform: uppercase;
      color: var(--muted);
    }

    .muted-copy { color: var(--muted); }

    .pill {
      display: inline-flex;
      align-items: center;
      gap: 0.4rem;
      border-radius: 999px;
      padding: 0.55rem 0.9rem;
      background: rgba(31, 94, 255, 0.08);
      color: var(--accent-strong);
      font-weight: 600;
    }

    .pill-dot {
      width: 0.55rem;
      height: 0.55rem;
      border-radius: 999px;
      background: #22c55e;
      box-shadow: 0 0 0 4px rgba(34, 197, 94, 0.15);
    }

    .logout-btn {
      border-color: rgba(180, 35, 24, 0.2);
      color: var(--danger);
      background: rgba(180, 35, 24, 0.06);
    }

    .logout-btn:hover {
      color: #fff;
      background: var(--danger);
      border-color: var(--danger);
    }

    .form-control,
    .form-control:focus {
      border-radius: 16px;
      box-shadow: none;
    }

    .form-control {
      border-color: rgba(26, 29, 36, 0.12);
      background: rgba(255, 255, 255, 0.9);
    }

    .btn {
      border-radius: 16px;
      font-weight: 600;
    }

    .btn-primary {
      background: var(--accent);
      border-color: var(--accent);
    }

    .btn-primary:hover {
      background: var(--accent-strong);
      border-color: var(--accent-strong);
    }

    .item-card {
      border: 1px solid rgba(26, 29, 36, 0.08);
      background: rgba(255, 255, 255, 0.75);
      border-radius: 22px;
      box-shadow: 0 12px 30px rgba(28, 31, 38, 0.05);
    }

    .list-group-item {
      border-color: rgba(26, 29, 36, 0.08);
      background: rgba(255, 255, 255, 0.88);
    }

    .is-saving {
      opacity: 0.7;
      pointer-events: none;
    }

    .empty-state {
      border: 1px dashed rgba(26, 29, 36, 0.16);
      border-radius: 20px;
      padding: 1rem 1.1rem;
      color: var(--muted);
      background: rgba(255, 255, 255, 0.55);
    }

    .status-banner {
      border-radius: 18px;
      padding: 0.9rem 1rem;
      border: 1px solid transparent;
    }

    .status-banner.error {
      border-color: rgba(180, 35, 24, 0.25);
      background: rgba(180, 35, 24, 0.08);
      color: #8f1d14;
    }

    .status-banner.success {
      border-color: rgba(19, 117, 71, 0.22);
      background: rgba(19, 117, 71, 0.08);
      color: #11553a;
    }

    summary { list-style: none; }
    summary::-webkit-details-marker { display: none; }
  </style>
</head>
<body>
  <div class="container page-shell py-4 py-lg-5">
    <div class="hero-panel p-4 p-lg-5 mb-4 mb-lg-5">
      <div class="d-flex flex-column flex-lg-row justify-content-between align-items-start align-items-lg-center gap-3">
        <div>
          <div class="eyebrow mb-2">Personal workspace</div>
          <h1 class="display-6 section-title mb-2">Notater og todo-lister</h1>
          <p class="muted-copy mb-0">Hold notater og oppgaver samlet i en ren arbeidsflate.</p>
        </div>

        <div class="d-flex align-items-center gap-2 flex-wrap justify-content-end">
          <span class="pill"><span class="pill-dot"></span><span>Logged in as <%= username %></span></span>
          <a href="/logout" class="btn logout-btn btn-sm px-3">Logout</a>
        </div>
      </div>

      <% if (typeof errorMessage !== 'undefined' && errorMessage) { %>
        <div class="status-banner error mt-4" id="status-banner"><%= errorMessage %></div>
      <% } else { %>
        <div class="status-banner success mt-4 d-none" id="status-banner"></div>
      <% } %>
    </div>

    <div class="row g-4 mb-4">
      <div class="col-12 col-xl-6">
        <div class="content-panel p-4 h-100">
          <div class="eyebrow mb-1">Notes</div>
          <h2 class="h4 section-title mb-3">Nytt notat</h2>

          <form action="/notes" method="POST" class="d-grid gap-3 js-ajax-form">
            <input class="form-control form-control-lg" type="text" name="title" placeholder="Tittel" required minlength="1" maxlength="120">
            <input class="form-control form-control-lg" type="text" name="content" placeholder="Innhold" required minlength="1" maxlength="1000">
            <button class="btn btn-primary btn-lg align-self-start px-4">Legg til</button>
          </form>
        </div>
      </div>

      <div class="col-12 col-xl-6">
        <div class="content-panel p-4 h-100">
          <div class="eyebrow mb-1">Todos</div>
          <h2 class="h4 section-title mb-3">Ny todo-liste</h2>

          <form action="/todos" method="POST" class="d-grid gap-3 js-ajax-form">
            <input class="form-control form-control-lg" type="text" name="title" placeholder="Tittel" required minlength="1" maxlength="120">
            <input class="form-control form-control-lg" type="text" name="tasks" placeholder="Oppgaver (komma-separert)" required minlength="1" maxlength="1000">
            <button class="btn btn-primary btn-lg align-self-start px-4">Legg til</button>
          </form>
        </div>
      </div>
    </div>

    <div class="row g-4">
      <div class="col-12 col-xl-6">
        <div class="content-panel p-4 h-100">
          <div class="eyebrow mb-1">Notes list</div>
          <h2 class="h4 section-title mb-3">Dine notater</h2>

          <div id="notes-list">
          <% if (data && data.notes && data.notes.length > 0) { %>
            <div class="d-grid gap-3">
              <% data.notes.forEach(note => { %>
                <div class="item-card p-3 p-lg-4" data-note-id="<%= note.id %>">
                  <strong class="d-block fs-5 mb-2"><%= note.title %></strong>
                  <span class="d-block muted-copy"><%= note.content %></span>

                  <div class="mt-3 d-flex gap-2 flex-wrap">
                    <details class="note-editor">
                      <summary class="btn btn-sm btn-primary">Edit</summary>
                      <form action="/notes/edit/<%= note.id %>" method="POST" class="mt-3 d-flex gap-2 flex-wrap js-ajax-form">
                        <input class="form-control" type="text" name="title" value="<%= note.title %>" required minlength="1" maxlength="120">
                        <input class="form-control" type="text" name="content" value="<%= note.content %>" required minlength="1" maxlength="1000">
                        <button type="submit" class="btn btn-sm btn-success">Save</button>
                      </form>
                    </details>

                    <form action="/notes/delete/<%= note.id %>" method="POST" class="js-ajax-form">
                      <button type="submit" class="btn btn-sm btn-danger">Delete</button>
                    </form>
                  </div>
                </div>
              <% }) %>
            </div>
          <% } else { %>
            <div class="empty-state">Ingen notater funnet</div>
          <% } %>
          </div>
        </div>
      </div>

      <div class="col-12 col-xl-6">
        <div class="content-panel p-4 h-100">
          <div class="eyebrow mb-1">Todo list</div>
          <h2 class="h4 section-title mb-3">Dine todo-lister</h2>

          <div id="todos-list">
          <% if (data && data.todos && data.todos.length > 0) { %>
            <div class="d-grid gap-3">
              <% data.todos.forEach(todo => { %>
                <div class="item-card p-3 p-lg-4" data-todo-id="<%= todo.id %>">
                  <div class="d-flex justify-content-between align-items-center gap-3">
                    <strong class="fs-5"><%= todo.title %></strong>

                    <form action="/todos/delete/<%= todo.id %>" method="POST" class="js-ajax-form">
                      <button class="btn btn-sm btn-danger">Delete</button>
                    </form>
                  </div>

                  <ul class="list-group mt-3 rounded-4 overflow-hidden">
                    <% todo.tasks.forEach(task => { %>
                      <li class="list-group-item d-flex justify-content-between align-items-center gap-3">
                        <span class="<%= task.completed ? 'text-decoration-line-through text-muted' : '' %>">
                          <%= task.text %>
                        </span>

                        <form action="/tasks/toggle/<%= task.id %>" method="POST" class="js-ajax-form">
                          <button class="btn btn-sm <%= task.completed ? 'btn-success' : 'btn-outline-secondary' %>">
                            <%= task.completed ? 'Done' : 'Mark' %>
                          </button>
                        </form>
                      </li>
                    <% }) %>
                  </ul>
                </div>
              <% }) %>
            </div>
          <% } else { %>
            <div class="empty-state">Ingen todo-lister funnet</div>
          <% } %>
          </div>
        </div>
      </div>
    </div>
  </div>

  <script>
    const notesList = document.getElementById("notes-list");
    const todosList = document.getElementById("todos-list");
    function noteCard(note) {
      return `
        <div class="item-card p-3 p-lg-4" data-note-id="${note.id}">
          <strong class="d-block fs-5 mb-2">${escapeHtml(note.title)}</strong>
          <span class="d-block muted-copy">${escapeHtml(note.content)}</span>

          <div class="mt-3 d-flex gap-2 flex-wrap">
            <details class="note-editor">
              <summary class="btn btn-sm btn-primary">Edit</summary>
              <form action="/notes/edit/${note.id}" method="POST" class="mt-3 d-flex gap-2 flex-wrap js-ajax-form">
                <input class="form-control" type="text" name="title" value="${escapeAttr(note.title)}">
                <input class="form-control" type="text" name="content" value="${escapeAttr(note.content)}">
                <button type="submit" class="btn btn-sm btn-success">Save</button>
              </form>
            </details>

            <form action="/notes/delete/${note.id}" method="POST" class="js-ajax-form">
              <button type="submit" class="btn btn-sm btn-danger">Delete</button>
            </form>
          </div>
        </div>
      `;
    }

    function todoCard(todo) {
      return `
        <div class="item-card p-3 p-lg-4" data-todo-id="${todo.id}">
          <div class="d-flex justify-content-between align-items-center gap-3">
            <strong class="fs-5">${escapeHtml(todo.title)}</strong>

            <form action="/todos/delete/${todo.id}" method="POST" class="js-ajax-form">
              <button class="btn btn-sm btn-danger">Delete</button>
            </form>
          </div>

          <ul class="list-group mt-3 rounded-4 overflow-hidden">
            ${todo.tasks.map((task) => `
              <li class="list-group-item d-flex justify-content-between align-items-center gap-3">
                <span class="${task.completed ? 'text-decoration-line-through text-muted' : ''}">
                  ${escapeHtml(task.text)}
                </span>

                <form action="/tasks/toggle/${task.id}" method="POST" class="js-ajax-form">
                  <button class="btn btn-sm ${task.completed ? 'btn-success' : 'btn-outline-secondary'}">
                    ${task.completed ? 'Done' : 'Mark'}
                  </button>
                </form>
              </li>
            `).join('')}
          </ul>
        </div>
      `;
    }

    function renderDashboard(data) {
      const notes = data?.notes || [];
      const todos = data?.todos || [];

      notesList.innerHTML = notes.length
        ? `<div class="d-grid gap-3">${notes.map(noteCard).join("")}</div>`
        : `<div class="empty-state">Ingen notater funnet</div>`;

      todosList.innerHTML = todos.length
        ? `<div class="d-grid gap-3">${todos.map(todoCard).join("")}</div>`
        : `<div class="empty-state">Ingen todo-lister funnet</div>`;
    }

    function escapeHtml(value) {
      return String(value)
        .replaceAll("&", "&amp;")
        .replaceAll("<", "&lt;")
        .replaceAll(">", "&gt;")
        .replaceAll('"', "&quot;")
        .replaceAll("'", "&#39;");
    }

    function escapeAttr(value) {
      return escapeHtml(value).replaceAll("`", "&#96;");
    }

    async function refreshSnapshot() {
      const response = await fetch('/snapshot', { headers: { Accept: 'application/json' } });
      if (!response.ok) throw new Error('Snapshot fetch failed');
      return response.json();
    }

    function showStatus(message, type = 'error') {
      const banner = document.getElementById('status-banner');
      if (!banner) return;
      banner.className = `status-banner ${type}`;
      banner.textContent = message;
    }

    async function submitForm(form) {
      const submitButton = form.querySelector('button[type="submit"]');
      form.classList.add('is-saving');
      if (submitButton) submitButton.disabled = true;

      try {
        const response = await fetch(form.action, {
          method: (form.method || 'POST').toUpperCase(),
          body: new FormData(form),
          headers: { 'X-Requested-With': 'fetch' }
        });

        if (!response.ok) {
          const payload = await response.json().catch(() => ({}));
          throw new Error(payload.error || 'Noe gikk galt. Sjekk inndata og prøv igjen.');
        }

        const snapshot = await refreshSnapshot();
        renderDashboard(snapshot.data);
        showStatus('Lagret.', 'success');
      } finally {
        if (submitButton) submitButton.disabled = false;
        form.classList.remove('is-saving');
      }
    }

    document.addEventListener('submit', (event) => {
      const form = event.target;
      if (!form.matches('.js-ajax-form, form[action="/notes"], form[action="/todos"]')) return;
      event.preventDefault();
      submitForm(form).catch((error) => {
        showStatus(error.message || 'Noe gikk galt. Sjekk inndata og prøv igjen.', 'error');
      });
    });
  </script>
</body>
</html>