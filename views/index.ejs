<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <title>Notes & Todos</title>
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
</head>
<body class="container py-5">

  <div class="d-flex justify-content-between align-items-center mb-4">
    <h1>Notater</h1>
    <a href="/logout" class="btn btn-outline-danger btn-sm">Logout</a>
  </div>

  <form action="/notes" method="POST" class="mb-4 d-flex gap-2">
    <input class="form-control" type="text" name="title" placeholder="Tittel" required>
    <input class="form-control" type="text" name="content" placeholder="Innhold" required>
    <button class="btn btn-primary btn-sm">Legg til</button>
  </form>

  <% if (data && data.notes && data.notes.length > 0) { %>
    <% data.notes.forEach(note => { %>
      <div class="mb-3 border rounded p-3">
        <strong class="d-block fs-5"><%= note.title %></strong>
        <span class="d-block mt-1"><%= note.content %></span>

        <div class="mt-2 d-flex gap-2 flex-wrap">
          <details>
            <summary class="btn btn-sm btn-primary">Edit</summary>
            <form action="/notes/edit/<%= note.id %>" method="POST" class="mt-2 d-flex gap-2 flex-wrap">
              <input class="form-control" type="text" name="title" value="<%= note.title %>">
              <input class="form-control" type="text" name="content" value="<%= note.content %>">
              <button type="submit" class="btn btn-sm btn-success">Save</button>
            </form>
          </details>

          <form action="/notes/delete/<%= note.id %>" method="POST">
            <button type="submit" class="btn btn-sm btn-danger">Delete</button>
          </form>
        </div>
      </div>
    <% }) %>
  <% } else { %>
    <p>Ingen notater funnet</p>
  <% } %>


  <h1 class="mt-5">Todo-lister</h1>

  <form action="/todos" method="POST" class="mb-4 d-flex gap-2">
    <input class="form-control" type="text" name="title" placeholder="Tittel" required>
    <input class="form-control" type="text" name="tasks" placeholder="Oppgaver (komma-separert)" required>
    <button class="btn btn-primary btn-sm">Legg til</button>
  </form>

  <% if (data && data.todos && data.todos.length > 0) { %>
    <% data.todos.forEach(todo => { %>
      <div class="mb-3 border rounded p-3">
        <div class="d-flex justify-content-between align-items-center">
          <strong class="fs-5"><%= todo.title %></strong>

          <form action="/todos/delete/<%= todo.id %>" method="POST">
            <button class="btn btn-sm btn-danger">Delete</button>
          </form>
        </div>

        <ul class="list-group mt-2">
          <% todo.tasks.forEach(task => { %>
            <li class="list-group-item d-flex justify-content-between align-items-center">
              <span class="<%= task.completed ? 'text-decoration-line-through text-muted' : '' %>">
                <%= task.text %>
              </span>

              <form action="/tasks/toggle/<%= task.id %>" method="POST">
                <button class="btn btn-sm <%= task.completed ? 'btn-success' : 'btn-outline-secondary' %>">
                  <%= task.completed ? 'Done' : 'Mark' %>
                </button>
              </form>
            </li>
          <% }) %>
        </ul>
      </div>
    <% }) %>
  <% } else { %>
    <p>Ingen todo-lister funnet</p>
  <% } %>

</body>
</html>