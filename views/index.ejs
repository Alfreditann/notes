<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <title>Notes & Todos</title>
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
</head>
<body class="container py-5">

  <h1>Notater</h1>
  <form action="/notes" method="POST" class="mb-4">
    <input type="text" name="title" placeholder="Tittel" required>
    <input type="text" name="content" placeholder="Innhold" required>
    <button class="btn btn-primary btn-sm">Legg til notat</button>
  </form>

  <% if (data && data.notes) { %>
    <% data.notes.forEach(note => { %>
      <div class="mb-3 border p-2">
        <strong class="d-block"><%= note.title %></strong>
        <span class="d-block mt-1"><%= note.content %></span>
        <div class="mt-2">
          <details class="d-inline-block me-2">
            <summary class="btn btn-sm btn-primary">Edit</summary>
            <form action="/notes/edit/<%= note.id %>" method="POST" class="mt-2 d-flex gap-2 flex-wrap align-items-center">
              <input type="text" name="title" placeholder="Ny tittel" value="<%= note.title %>">
              <input type="text" name="content" placeholder="Nytt innhold" value="<%= note.content %>">
              <button type="submit" class="btn btn-sm btn-primary">Save</button>
            </form>
          </details>
          <form action="/notes/delete/<%= note.id %>" method="POST" class="d-inline">
            <button type="submit" class="btn btn-sm btn-danger">Delete</button>
          </form>
        </div>
      </div>
    <% }) %>
  <% } else { %>
    <p>Ingen notater funnet</p>
  <% } %>

  <h1>Todo-lister</h1>
  <form action="/todos" method="POST" class="mb-4">
    <input type="text" name="title" placeholder="Tittel" required>
    <input type="text" name="tasks" placeholder="Oppgaver (komma-separert)" required>
    <button class="btn btn-primary btn-sm">Legg til todo</button>
  </form>

  <% if (data && data.todos) { %>
    <% data.todos.forEach(todo => { %>
      <div class="mb-3 border p-2">
        <strong><%= todo.title %></strong>
        <form action="/todos/delete/<%= todo.id %>" method="POST" class="d-inline float-end">
          <button class="btn btn-sm btn-danger">Delete todo</button>
        </form>
        <ul class="list-group mt-2">
          <% todo.tasks.forEach(task => { %>
            <li class="list-group-item d-flex justify-content-between align-items-center">
              <span class="<%= task.completed ? 'text-decoration-line-through' : '' %>">
                <%= task.text %>
              </span>
              <form action="/tasks/toggle/<%= task.id %>" method="POST" class="d-inline">
                <button class="btn btn-sm <%= task.completed ? 'btn-success' : 'btn-danger' %>">Toggle</button>
              </form>
            </li>
          <% }) %>
        </ul>
      </div>
    <% }) %>
  <% } else { %>
    <p>Ingen todo-lister funnet</p>
  <% } %>

</body>
</html>